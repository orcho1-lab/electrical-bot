# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
SITE_PASSWORD=your-site-password-here

# ── Cloud Run / PostgreSQL (leave empty for local SQLite) ─────────────────────
# Format for Cloud SQL via Unix socket (Cloud Run):
#   postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Format for local PostgreSQL:
#   postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=

# ── Cloud Storage for image uploads (leave empty to use local disk) ───────────
GCS_BUCKET=
